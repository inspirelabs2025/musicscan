# Supabase project credentials (can be found in Supabase project settings)
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# Vite environment variables (must be prefixed with VITE_)
VITE_SUPABASE_PROJECT_ID="YOUR_SUPABASE_PROJECT_ID"
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_GA_MEASUREMENT_ID="YOUR_GA_MEASUREMENT_ID"

# Growth Nudge Variants (set to "" to disable, or specific variant name to enable)
# Example: VITE_AI_NUDGE_VARIANT="nudge"
VITE_AI_NUDGE_VARIANT=""

# Example: VITE_CHAT_NUDGE_VARIANT="new_chat_user"
VITE_CHAT_NUDGE_VARIANT=""

# AI Features Nudge Variant
# 'new_user_0x_used': Shows the nudge to new users who haven't used AI features.
VITE_AI_FEATURES_NUDGE_VARIANT=""
